# PostgreSQL
DATABASE_URL=postgres://vpnos:vpnos_pass@postgres:5432/vpnos?sslmode=disable

# Backend
BACKEND_PORT=8080
ADMIN_API_KEY=supersecretapikey
LOG_LEVEL=info

# x-ui integration
XUI_BASE_URL=http://x-ui:2053
XUI_USERNAME=admin
XUI_PASSWORD=CHANGE_ME
XUI_INBOUND_ID=1
XRAY_HOST=vpn.example.com
XRAY_PORT=443
XRAY_SERVER_PUBKEY=<server_public_key_placeholder>
XRAY_SHORT_ID=<shortid_placeholder>

# Retry config
XRAY_RETRY_COUNT=3
XRAY_BACKOFF_BASE_MS=50
